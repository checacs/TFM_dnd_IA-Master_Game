# Variables del docker-compose.yml de la raíz (copia este archivo a ".env" en
# la raíz si quieres cambiar algo; sin él, se usan los valores por defecto).
# Los secretos de cada servicio siguen en "API_REST TFM/.env" y "dm-engine/.env".

# Secreto compartido API <-> dm-engine dentro de Docker. Para uso local basta el
# valor por defecto; genera uno real con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# INTERNAL_API_KEY=

# Base de datos. Por defecto, el contenedor mongo del compose
# (mongodb://mongo:27017/dnd-ia-master). Cuidado si apuntas a tu Atlas de
# producción: las partidas que juegues en local (y el seed) escribirán allí.
# MONGODB_URI=


docker compose up --build -d
docker compose --profile seed run --rm seed