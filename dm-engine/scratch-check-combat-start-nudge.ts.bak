import { runDmTurn } from './src/dm-turn';
import { ToolCaller, ChatClient, ChatMessage, McpToolInfo } from './src/ports';

async function scenario1() {
  // Caso real: combate empieza narrativamente, jugador dice "Nos preparamos
  // para atacarla", no hay activeEncounter, el modelo NUNCA llama a
  // start_combat -- debe forzarse el aviso.
  let getGameStateCalls = 0;
  const toolCaller: ToolCaller = {
    listTools: async (): Promise<McpToolInfo[]> => [],
    callTool: async (name: string) => {
      if (name === 'get_game_state') {
        getGameStateCalls++;
        return { activeEncounter: null, players: [] };
      }
      throw new Error('tool inesperada: ' + name);
    },
  };
  let callCount = 0;
  const chatClient: ChatClient = {
    createCompletion: async () => {
      callCount++;
      if (callCount === 1) {
        return { message: { role: 'assistant', content: '¡Ya no hay sorpresa que valga -- el combate ha comenzado! ¿Qué hacéis?' } };
      }
      return { message: { role: 'assistant', content: 'Vale, corrijo: llamo a start_combat primero.' } };
    },
  };
  const messages: ChatMessage[] = [{ role: 'user', content: 'Nos preparamos para atacarla' }, { role: 'user', content: 'Nos preparamos para atacarla' }, { role: 'user', content: 'Nos preparamos para atacarla' }, { role: 'user', content: 'Nos preparamos para atacarla' }, { role: 'user', content: 'Nos preparamos para atacarla' }, { role: 'user', content: 'Nos preparamos para atacarla' }, { role: 'user', content: 'Nos preparamos para atacarla' }, { role: 'user', content: 'Nos preparamos para atacarla' }, { role: 'user', content: 'Nos preparamos para atacarla' }, { role: 'user', content: 'Nos preparamos para atacarla' }, { role: 'user', content: 'Nos preparamos para atacarla' }];
  const result = await runDmTurn(chatClient, toolCaller, messages, 'g1');
  const pass = callCount === 3 && getGameStateCalls >= 2; // 2 avisos consecutivos (MAX_CORRECTION_ATTEMPTS=2) + narrativa final
  console.log(`[${pass ? 'OK' : 'FALLO'}] escenario 1 (combate sin start_combat) -> intentos LLM=${callCount}, get_game_state llamado=${getGameStateCalls}, narrativa final="${result.narrative}"`);
}

async function scenario2() {
  // Control: combate YA activo, el jugador dice "Atacamos", el DM solo hace
  // una pregunta aclaratoria sin tocar tools -- NO debe dispararse ningún
  // aviso (evitar el falso positivo).
  const toolCaller: ToolCaller = {
    listTools: async (): Promise<McpToolInfo[]> => [],
    callTool: async (name: string) => {
      if (name === 'get_game_state') {
        return { activeEncounter: { roundPhase: 'jugadores', enemies: [{ instanceId: 'e1', currentHp: 5 }] }, players: [] };
      }
      throw new Error('tool inesperada: ' + name);
    },
  };
  let callCount = 0;
  const chatClient: ChatClient = {
    createCompletion: async () => {
      callCount++;
      return { message: { role: 'assistant', content: '¿A quién apuntáis, a la Osa Lechuza o al Matón?' } };
    },
  };
  const messages: ChatMessage[] = Array.from({ length: 11 }, () => ({ role: 'user' as const, content: 'Atacamos' }));
  const result = await runDmTurn(chatClient, toolCaller, messages, 'g1');
  const pass = callCount === 1; // sin corrección: solo 1 llamada al LLM
  console.log(`[${pass ? 'OK' : 'FALLO'}] escenario 2 (combate ya activo, pregunta aclaratoria) -> intentos LLM=${callCount}, narrativa="${result.narrative}"`);
}

async function main() {
  await scenario1();
  await scenario2();
}
main();
